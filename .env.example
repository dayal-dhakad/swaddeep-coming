# Public ImageKit URL endpoint, for example: https://ik.imagekit.io/your_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Add server-only ImageKit credentials only if authenticated uploads are introduced.
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=

# Set to true to replace the website with the coming-soon screen.
SHOW_COMING_SOON=false
